---
import Base from '../../layouts/Base.astro';
import SnapshotForm from '../../components/SnapshotForm.astro';
import TierCards from '../../components/TierCards.astro';
import Faq from '../../components/Faq.astro';

const title = 'Preise — PartnerScope · Drittanbieter-KI-Risikobewertung';
const description =
  'Starter €99 · Pro €299 (Launch) · Enterprise €4 900/Quartal. Automatisierte Tests, Dokumentenprüfung und KI-Red-Teaming über 13 Dimensionen. EU AI Act, GDPR, DORA, NIS2.';
---

<Base title={title} description={description}>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">PartnerScope · Tarife</p>
      <h1>Drittanbieter-KI-Risiko — ohne 40-seitigen Fragebogen</h1>
      <p class="hero-sub">
        PartnerScope bewertet Ihre Anbieter über 13 Dimensionen — verhaltensbasiert, finanziell und
        KI-Compliance — mit automatisierten Tests, Dokumentenprüfung und KI-Red-Teaming. Direkt
        einsetzbare Reports im Einklang mit EU AI Act, GDPR, DORA und NIS2.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#tiers">Tarife ansehen →</a>
        <a class="btn btn-ghost" href="#snapshot">Kostenlosen Snapshot testen</a>
      </div>
      <ul class="trust-strip" aria-label="Vertrauensindikatoren">
        <li>Eingesetzt von Risiko-Teams im DACH-Raum</li>
        <li>48h SLA</li>
        <li>EU-gehostet · GDPR-konform</li>
        <li>Unabhängige Analysten</li>
      </ul>
    </div>
  </section>

  <section class="snapshot-strip">
    <div class="container snapshot-strip-inner">
      <div>
        <strong>Noch nicht bereit zu kaufen?</strong>
        Erhalten Sie einen 60-Sekunden-Risiko-Snapshot — 4 Fragen, kein Konto erforderlich.
      </div>
      <a class="btn btn-dark" href="#snapshot">Kostenlos testen →</a>
    </div>
  </section>

  <TierCards locale="de" />

  <section class="why section section-alt">
    <div class="container">
      <div class="why-head">
        <p class="eyebrow">Warum PartnerScope</p>
        <h2>Entwickelt für den EU-Risiko-Stack.</h2>
      </div>
      <div class="why-grid">
        <div class="why-col">
          <div class="why-icon">EU</div>
          <h3>Entwickelt für den EU-Stack.</h3>
          <p>
            EU AI Act, GDPR Art. 28, DORA Art. 28–30, NIS2. Jeder Befund mit Verweis auf Verordnung
            und Anhang.
          </p>
        </div>
        <div class="why-col">
          <div class="why-icon">✓</div>
          <h3>Auditierbare Nachweise.</h3>
          <p>
            Jede Aussage ist mit zeitgestempelten, SHA-256-gehashten Artefakten verknüpft.
            7 Jahre Object-Lock-Speicherung.
          </p>
        </div>
        <div class="why-col">
          <div class="why-icon">★</div>
          <h3>Unabhängig und namentlich.</h3>
          <p>
            Jeder Report ist von einem namentlich genannten Analysten und QA-Reviewer signiert.
            15 Tage Anbieter-Anhörungsrecht.
          </p>
        </div>
      </div>
    </div>
  </section>

  <SnapshotForm />

  <Faq />

  <section class="cta-strip section">
    <div class="container cta-inner">
      <div>
        <h2>Bereit zu starten?</h2>
        <p>Starten Sie einen Starter-Report in Minuten — oder sprechen Sie mit uns über Enterprise.</p>
        <p class="cta-method">
          Neugierig, wie wir Anbieter bewerten?
          <a href="/de/methodology">Bewertungsmethodik ansehen →</a>
        </p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href="#tiers">Tarife ansehen →</a>
        <a class="btn btn-ghost" href="mailto:elshan.musayev@partnerscope.eu?subject=PartnerScope%20Anfrage">
          Kontakt aufnehmen
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero {
    padding: 4rem 0 2.5rem;
    background:
      radial-gradient(1000px 400px at 90% -10%, rgba(79, 124, 255, 0.08), transparent 60%),
      radial-gradient(800px 400px at -10% 20%, rgba(79, 124, 255, 0.05), transparent 60%);
  }
  .hero-inner {
    max-width: 820px;
    text-align: center;
    margin: 0 auto;
  }
  .eyebrow {
    color: var(--ps-accent-strong);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    margin: 0 0 0.75rem;
  }
  .hero h1 {
    margin-bottom: 1rem;
  }
  .hero-sub {
    color: var(--ps-text);
    font-size: 1.1rem;
    max-width: 680px;
    margin: 0 auto 1.5rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .trust-strip {
    list-style: none;
    display: flex;
    gap: 1rem 2rem;
    padding: 0;
    margin: 2.5rem 0 0;
    justify-content: center;
    flex-wrap: wrap;
    color: var(--ps-muted);
    font-size: 0.85rem;
  }
  .trust-strip li {
    position: relative;
  }
  .trust-strip li + li::before {
    content: '·';
    position: absolute;
    left: -1rem;
    color: var(--ps-border);
  }

  .snapshot-strip {
    padding: 1.25rem 0;
    background: linear-gradient(90deg, #0f1a2b 0%, #1e2d47 100%);
    color: #e6ecf7;
  }
  .snapshot-strip-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .snapshot-strip strong {
    color: #fff;
    margin-right: 0.5rem;
  }
  .snapshot-strip .btn-dark {
    background: #fff;
    color: var(--ps-navy);
  }
  .snapshot-strip .btn-dark:hover {
    background: #e6ecf7;
  }

  .why-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
  .why-col {
    background: #fff;
    border: 1px solid var(--ps-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }
  .why-col h3 {
    margin: 0.75rem 0 0.5rem;
  }
  .why-icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: rgba(79, 124, 255, 0.1);
    color: var(--ps-accent-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .cta-strip .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 2rem;
    background: linear-gradient(135deg, #0f1a2b 0%, #1e2d47 100%);
    border-radius: var(--radius-lg);
    color: #e6ecf7;
  }
  .cta-strip h2 {
    color: #fff;
    margin: 0 0 0.25rem;
  }
  .cta-strip p {
    margin: 0;
    color: #c8d1e3;
  }
  .cta-strip p.cta-method {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: #a5b1c9;
  }
  .cta-strip p.cta-method a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }
  .cta-strip p.cta-method a:hover {
    text-decoration-color: #fff;
  }
  .cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cta-actions .btn-ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .cta-actions .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.6);
  }

</style>
