---
/**
 * /checkout/success — post-Stripe Checkout thank-you page.
 *
 * Stripe redirects here after a successful session (see STRIPE_SUCCESS_URL).
 * The session_id query param is read client-side for display only — the
 * authoritative record is the webhook (/v1/webhooks/stripe) which the API
 * processes out-of-band. We never call Stripe from the browser.
 */

import Base from '../../layouts/Base.astro';
---
<Base
  title="Request received — PartnerScope"
  description="Your PartnerScope request has been received. We confirm scope, price and delivery date by email."
>
  <section class="success section">
    <div class="container success-inner">
      <div class="success-check" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
          <path d="M5 12l5 5L20 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <p class="eyebrow">Request received</p>
      <h1>Thank you — we have your request.</h1>
      <p class="lead">
        Opening this page does not create an order or confirm a payment. If you arrived here from a
        Stripe checkout, your payment is being verified on our side and you will receive an email
        once it is confirmed.
      </p>

      <div class="next">
        <h2>What happens next</h2>
        <ol>
          <li>We confirm scope, price and delivery date by email within one business day.</li>
          <li>
            Starter: automated checks on the vendor domain (DNS, TLS, HTTP security headers, CT log).
            Pro: documentary review and analyst assessment of the agreed product and use case.
          </li>
          <li>You receive the signed PDF report by email on the confirmed delivery date.</li>
        </ol>
        <p class="next-method">
          Want to know exactly how we score your vendor?
          <a href="/methodology">Read our assessment methodology →</a>
        </p>
      </div>

      <div class="session">
        <div class="session-label">Order reference</div>
        <code id="session-id">—</code>
        <p class="tiny">
          Keep this ID — include it in any reply if you need to reach us about this order.
        </p>
      </div>

      <div class="actions">
        <a class="btn btn-primary" href="/dashboard">Go to dashboard →</a>
        <a class="btn btn-ghost" href="mailto:elshan.musayev@partnerscope.eu?subject=PartnerScope%20order%20question">Email us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .success-inner {
    max-width: 640px;
    text-align: center;
  }
  .success-check {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: rgba(27, 143, 79, 0.12);
    color: var(--band-minimal);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .eyebrow {
    color: var(--band-minimal);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    margin: 0;
  }
  .lead {
    color: var(--ps-text);
    font-size: 1.05rem;
    max-width: 520px;
    margin: 0.5rem auto 2rem;
  }
  .next {
    background: var(--ps-paper-soft);
    border: 1px solid var(--ps-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
    text-align: left;
    margin: 0 auto 1.5rem;
  }
  .next h2 {
    margin-top: 0;
    font-size: 1.1rem;
  }
  .next ol {
    padding-left: 1.1rem;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .next-method {
    margin: 1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--ps-border);
    font-size: 0.9rem;
    color: var(--ps-muted);
  }
  .next-method a {
    color: var(--ps-accent-strong);
    text-decoration: none;
    font-weight: 600;
  }
  .next-method a:hover {
    text-decoration: underline;
  }
  .session {
    background: var(--ps-paper);
    border: 1px dashed var(--ps-border);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin: 0 auto 1.5rem;
    max-width: 420px;
  }
  .session-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ps-muted);
  }
  .session code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ps-ink);
    margin: 0.3rem 0 0.4rem;
    word-break: break-all;
  }
  .tiny {
    color: var(--ps-muted);
    font-size: 0.78rem;
    margin: 0;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

<script>
  const url = new URL(window.location.href);
  const sid = url.searchParams.get('session_id');
  const el = document.getElementById('session-id');
  if (el) {
    el.textContent = sid && sid.length > 0 ? sid : '— (no session ID in URL)';
  }
</script>
