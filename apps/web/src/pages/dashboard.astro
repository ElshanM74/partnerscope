---
/**
 * /dashboard — authenticated landing page.
 *
 * Thin MVP: verifies the JWT via GET /api/v1/auth/me on load. If the token is
 * missing or invalid, redirects to /login. Otherwise greets the user and
 * shows placeholder sections for "Your runs" and a CTA to start one.
 */
import Base from '../layouts/Base.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? '/api';
---
<Base
  title="Dashboard — PartnerScope"
  description="Your PartnerScope dashboard."
>
  <section class="dash section" data-api-base={apiBase}>
    <div class="container dash-inner">
      <div id="dash-banner" class="dash-banner" role="status" hidden>
        <span id="dash-banner-text"></span>
        <button id="dash-banner-action" type="button" hidden>Retry</button>
      </div>
      <div id="dash-loading" class="dash-state" aria-live="polite">
        <div class="dash-spinner" aria-hidden="true"></div>
        <p class="muted">Loading your assessments…</p>
      </div>

      <div id="dash-content" hidden>
        <header class="dash-head">
          <h1>Welcome, <span id="dash-name">there</span>.</h1>
          <p class="dash-sub">
            You're logged in as <span id="dash-email" class="mono"></span> ·
            <a href="/account">Account settings &amp; purchased services</a> · <a id="dash-operations" href="/operations" hidden>Service operations</a> ·
            <a href="/research">Поиск партнёров · Beta ↗</a>
          </p>
        </header>

        <p><a class="btn btn-primary" href="/research">Найти и проверить партнёров с ИИ</a></p>
        <div class="cards">
          <div class="card">
            <div class="card-head">
              <h2>Your assessments</h2>
              <button id="add-vendor-toggle" type="button" class="btn btn-ghost btn-sm">Start assessment</button>
            </div>
            <form id="add-vendor-form" class="add-vendor-form" hidden>
              <div class="avf-row">
                <input id="avf-name" type="text" placeholder="Legal name (e.g. Azersun Holding)" required maxlength="255" />
                <input id="avf-domain" type="text" placeholder="Domain (e.g. azersun.com)" required />
              </div>
              <div class="avf-row">
                <input id="avf-industry" type="text" placeholder="Direction / industry (e.g. FMCG & Food)" maxlength="100" />
                <input id="avf-country" type="text" placeholder="Country (ISO-2)" value="AZ" maxlength="2" />
              </div>
              <div class="avf-actions">
                <button type="submit" class="btn btn-primary btn-sm">Continue to questionnaire</button>
                <button id="avf-cancel" type="button" class="btn btn-ghost btn-sm">Cancel</button>
                <span id="avf-msg" class="avf-msg" role="status"></span>
              </div>
            </form>
            <div id="run-filters" class="run-filters" hidden></div>
            <div id="run-list" class="run-list">
              <p class="muted">Loading…</p>
            </div>
            <div id="run-empty" class="card-actions" hidden>
              <a class="btn btn-primary" href="/plans#snapshot">Run a free snapshot</a>
              <a class="btn btn-ghost" href="/plans#tiers">View plans</a>
            </div>
            <div class="dash-cta-row">
              <a href="/methodology">How we score &rarr;</a>
              <a href="mailto:hello@partnerscope.eu?subject=New%20assessment%20request">Request a new assessment &rarr;</a>
            </div>
          </div>

          <div class="card">
            <h2>Live monitoring · alerts</h2>
            <div id="mon-feed" class="mon-feed">
              <p class="muted">Loading…</p>
            </div>
          </div>

          <div class="card">
            <h2>Organization</h2>
            <p class="muted">
              <span id="dash-role" class="badge">viewer</span>
              <span id="dash-org-id" class="mono tiny"></span>
            </p>
            <p class="muted tiny">
              Multi-user orgs and team invites are coming soon. For now every
              account owns one organization.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .dash-inner { max-width: 960px; }
  .dash-head { margin-bottom: 2rem; }
  .dash-head h1 { margin: 0 0 0.35rem; }
  .dash-sub { color: var(--ps-muted); margin: 0; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
  .card {
    background: var(--ps-paper);
    border: 1px solid var(--ps-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .card h2 { margin-top: 0; font-size: 1.1rem; }
  .card-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .muted { color: var(--ps-muted); }
  .tiny { font-size: 0.82rem; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.88rem; }
  .badge {
    display: inline-block;
    background: rgba(79, 124, 255, 0.12);
    color: var(--ps-accent-strong);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: 0.5rem;
  }
  .dash-state { padding: 3rem 0; text-align: center; }
  .dash-spinner {
    width: 36px; height: 36px;
    border: 3px solid var(--ps-border);
    border-top-color: var(--ps-accent-strong);
    border-radius: 50%;
    margin: 0 auto 0.75rem;
    animation: dashSpin 0.85s linear infinite;
  }
  @keyframes dashSpin { to { transform: rotate(360deg); } }
  .dash-banner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem;
    background: #fef3c7; color: #92400e;
    border: 1px solid #fde68a;
    border-radius: 0.55rem;
    padding: 0.7rem 0.95rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .dash-banner.dash-banner-error {
    background: #fee2e2; color: #991b1b; border-color: #fecaca;
  }
  .dash-banner button {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0.4rem;
    padding: 0.3rem 0.7rem;
    font-weight: 600;
    cursor: pointer;
    color: inherit;
    font-size: 0.82rem;
  }
  .run-list { display: flex; flex-direction: column; gap: 0.65rem; margin-top: 0.25rem; }
  .run-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.7rem 0.85rem; border: 1px solid var(--ps-border);
    border-radius: 0.55rem; background: rgba(255,255,255,0.55);
  }
  .run-name { font-weight: 600; font-size: 0.95rem; margin: 0; }
  .run-domain { color: var(--ps-muted); font-size: 0.78rem; margin: 0.15rem 0 0; }
  .run-meta { display: flex; gap: 0.5rem; align-items: center; font-size: 0.74rem; }
  .pill {
    display: inline-block; padding: 0.18rem 0.55rem; border-radius: 999px;
    font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .pill-tier-starter { background: #e0f2fe; color: #0369a1; }
  .pill-tier-pro { background: #ede9fe; color: #6d28d9; }
  .pill-tier-enterprise { background: #fef3c7; color: #b45309; }
  .pill-tier-free_snapshot { background: #f1f5f9; color: #475569; }
  /* Static-class rules — Astro keeps these because the classes appear in markup. */
  .pill-status-draft { background: #f1f5f9; color: #64748b; }
  .pill-status-queued { background: #fef9c3; color: #a16207; }
  .pill-status-running { background: #dbeafe; color: #1e40af; }
  .pill-status-scoring { background: #dbeafe; color: #1e40af; }
  .pill-status-analyst_review { background: #fae8ff; color: #86198f; }
  .pill-status-qa_review { background: #fae8ff; color: #86198f; }
  .pill-status-scored { background: #dcfce7; color: #166534; }
  .pill-status-delivered { background: #dcfce7; color: #166534; }
  .pill-status-failed { background: #fee2e2; color: #b91c1c; }
  .pill-status-cancelled { background: #f1f5f9; color: #64748b; }
  .pill-status-archived { background: #f1f5f9; color: #64748b; }
  .pill-band-MINIMAL { background: #d1fae5; color: #065f46; }
  .pill-band-LOW { background: #dcfce7; color: #166534; }
  .pill-band-MEDIUM { background: #fef3c7; color: #92400e; }
  .pill-band-HIGH { background: #fee2e2; color: #991b1b; }
  .run-score {
    font: 700 1.05rem ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--ps-accent-strong);
    margin-right: 0.4rem;
  }
  .run-score-out-of {
    font-size: 0.7rem;
    color: var(--ps-muted);
    font-weight: 500;
  }
  .run-delivered {
    font-size: 0.72rem;
    color: var(--ps-muted);
    margin: 0.2rem 0 0;
  }
  .dash-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ps-border);
  }
  .dash-cta-row a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    border-radius: 0.5rem;
    background: rgba(79, 124, 255, 0.08);
    color: var(--ps-accent-strong);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  .dash-cta-row a:hover { background: rgba(79, 124, 255, 0.15); }
</style>

<!-- Astro scopes <style> to selectors that appear in the static markup; classes
     applied only by client-side JS (template literals below) get stripped. We need
     these dynamic-class rules to be GLOBAL so they survive the build. -->
<style is:global>
  .pill { display: inline-block; padding: 0.18rem 0.55rem; border-radius: 999px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
  .pill-tier-starter { background: #e0f2fe; color: #0369a1; }
  .pill-tier-pro { background: #ede9fe; color: #6d28d9; }
  .pill-tier-enterprise { background: #fef3c7; color: #b45309; }
  .pill-tier-free_snapshot { background: #f1f5f9; color: #475569; }
  .pill-status-draft { background: #f1f5f9; color: #64748b; }
  .pill-status-queued { background: #fef9c3; color: #a16207; }
  .pill-status-running { background: #dbeafe; color: #1e40af; }
  .pill-status-scoring { background: #dbeafe; color: #1e40af; }
  .pill-status-analyst_review { background: #fae8ff; color: #86198f; }
  .pill-status-qa_review { background: #fae8ff; color: #86198f; }
  .pill-status-scored { background: #dcfce7; color: #166534; }
  .pill-status-delivered { background: #dcfce7; color: #166534; }
  .pill-status-failed { background: #fee2e2; color: #b91c1c; }
  .pill-status-cancelled { background: #f1f5f9; color: #64748b; }
  .pill-status-archived { background: #f1f5f9; color: #64748b; }
  .pill-band-MINIMAL { background: #d1fae5; color: #065f46; }
  .pill-band-LOW { background: #dcfce7; color: #166534; }
  .pill-band-MEDIUM { background: #fef3c7; color: #92400e; }
  .pill-band-HIGH { background: #fee2e2; color: #991b1b; }
  .run-row { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 0.85rem; border: 1px solid #e2e8f0; border-radius: 0.55rem; background: rgba(255,255,255,0.55); }
  .run-name { font-weight: 600; font-size: 0.95rem; margin: 0; }
  .run-link { color: #0f172a; text-decoration: none; }
  .run-link:hover { color: #4f7cff; text-decoration: underline; }
  .run-domain { color: #64748b; font-size: 0.78rem; margin: 0.15rem 0 0; }
  .run-meta { display: flex; gap: 0.5rem; align-items: center; font-size: 0.74rem; }
  .run-score { font: 700 1.05rem ui-monospace, SFMono-Regular, Menlo, monospace; color: #4f7cff; margin-right: 0.4rem; }
  .run-score-out-of { font-size: 0.7rem; color: #64748b; font-weight: 500; }
  .run-delivered { font-size: 0.72rem; color: #64748b; margin: 0.2rem 0 0; }
  .card-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .btn-sm { padding: 0.32rem 0.7rem; font-size: 0.8rem; }
  .add-vendor-form[hidden] { display: none; }
  .add-vendor-form { margin: 0.5rem 0 0.85rem; padding: 0.85rem; border: 1px solid #e2e8f0; border-radius: 0.6rem; background: #f8fafc; display: flex; flex-direction: column; gap: 0.55rem; }
  .avf-row { display: flex; gap: 0.55rem; }
  .avf-row input { flex: 1; min-width: 0; height: 2.3rem; padding: 0 0.65rem; border: 1px solid #cbd5e1; border-radius: 0.45rem; font-size: 0.85rem; background: #fff; }
  .avf-row input:focus { outline: none; border-color: #4f7cff; box-shadow: 0 0 0 3px rgba(79,124,255,0.15); }
  .avf-actions { display: flex; align-items: center; gap: 0.55rem; }
  .avf-msg { font-size: 0.78rem; color: #475569; }
  .avf-msg-error { color: #b91c1c; }
  .run-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.25rem 0 0.85rem; }
  .chip { padding: 0.25rem 0.6rem; border-radius: 999px; border: 1px solid #cbd5e1; background: #fff; color: #475569; font-size: 0.74rem; cursor: pointer; transition: all .12s; }
  .chip:hover { border-color: #94a3b8; }
  .chip-on { background: #0f172a; color: #fff; border-color: #0f172a; }
  .mon-feed { display: flex; flex-direction: column; gap: 0.45rem; }
  .mon-row { display: flex; gap: 0.6rem; align-items: center; padding: 0.5rem 0.6rem; border: 1px solid #e2e8f0; border-radius: 0.5rem; background: #fff; text-decoration: none; color: inherit; }
  .mon-row:hover { border-color: #94a3b8; }
  .mon-body { display: flex; flex-direction: column; min-width: 0; }
  .mon-vendor { font-weight: 600; font-size: 0.82rem; }
  .mon-sig { color: #64748b; font-size: 0.74rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sev { display: inline-block; padding: 0.12rem 0.5rem; border-radius: 999px; font-size: 0.66rem; font-weight: 700; text-transform: uppercase; white-space: nowrap; }
  .sev-low { background: #dcfce7; color: #166534; } .sev-medium { background: #fef3c7; color: #92400e; }
  .sev-high { background: #fee2e2; color: #991b1b; } .sev-critical { background: #7f1d1d; color: #fff; }
</style>

<script>
  const root = document.querySelector('.dash.section') as HTMLElement | null;
  const apiBase = root?.dataset.apiBase || '/api';

  function showBanner(message: string, options?: { error?: boolean; retry?: () => void }): void {
    const banner = document.getElementById('dash-banner');
    const text = document.getElementById('dash-banner-text');
    const action = document.getElementById('dash-banner-action') as HTMLButtonElement | null;
    if (text) text.textContent = message;
    if (banner) {
      banner.classList.toggle('dash-banner-error', options?.error === true);
      banner.hidden = false;
    }
    if (action) {
      if (options?.retry) {
        action.hidden = false;
        action.onclick = () => {
          if (banner) banner.hidden = true;
          options.retry?.();
        };
      } else {
        action.hidden = true;
        action.onclick = null;
      }
    }
  }

  function logoutAndRedirect(target = '/login', reason?: string): void {
    showBanner(reason ?? 'Signing you out…');
    setTimeout(() => {
      try {
        localStorage.removeItem('ps_token');
        localStorage.removeItem('ps_user');
      } catch {}
      window.location.replace(target);
    }, 800);
  }

  (async () => {
    let token: string | null = null;
    try {
      token = localStorage.getItem('ps_token');
    } catch {}
    if (!token) {
      logoutAndRedirect('/login', 'Please sign in to view your dashboard. Redirecting…');
      return;
    }

    try {
      const res = await fetch(`${apiBase}/v1/auth/me`, {
        headers: { authorization: `Bearer ${token}` },
      });
      if (res.status === 401) {
        logoutAndRedirect('/login', 'Your session expired. Redirecting to sign in…');
        return;
      }
      if (!res.ok) throw new Error(`me failed: ${res.status}`);
      const body = await res.json() as {
        user: { id: string; organizationId: string | null; email: string; fullName: string | null; role: string; isStaff?: boolean }; isStaff?: boolean;
      };
      const u = body.user;
      const operationsLink = document.getElementById("dash-operations");
      if (operationsLink) operationsLink.hidden = !(u.isStaff || body.isStaff);
      try { localStorage.setItem('ps_user', JSON.stringify(u)); } catch {}

      const name = u.fullName?.trim() || u.email.split('@')[0] || 'there';
      const nameEl = document.getElementById('dash-name');
      const emailEl = document.getElementById('dash-email');
      const roleEl = document.getElementById('dash-role');
      const orgEl = document.getElementById('dash-org-id');
      if (nameEl) nameEl.textContent = name;
      if (emailEl) emailEl.textContent = u.email;
      if (roleEl) roleEl.textContent = u.role;
      if (orgEl && u.organizationId) orgEl.textContent = `org ${u.organizationId.slice(0, 8)}…`;

      const loading = document.getElementById('dash-loading');
      const content = document.getElementById('dash-content');
      if (loading) loading.hidden = true;
      if (content) content.hidden = false;

      // Fetch runs + vendors in parallel and render the assessment list
      try {
        const [runsRes, vendorsRes, monRes] = await Promise.all([
          fetch(`${apiBase}/v1/runs`, { headers: { authorization: `Bearer ${token}` } }),
          fetch(`${apiBase}/v1/vendors`, { headers: { authorization: `Bearer ${token}` } }),
          fetch(`${apiBase}/v1/monitoring/feed`, { headers: { authorization: `Bearer ${token}` } }),
        ]);
        const runsBody = runsRes.ok ? await runsRes.json() : { data: [] };
        const vendorsBody = vendorsRes.ok ? await vendorsRes.json() : { data: [] };
        const monBody = monRes.ok ? await monRes.json() : { data: [] };
        const vendors = new Map<string, { legalName: string; domain: string; country: string | null; industry: string | null }>();
        for (const v of (vendorsBody as { data: Array<{ id: string; legalName: string; domain: string; country: string | null; industry: string | null }> }).data) {
          vendors.set(v.id, { legalName: v.legalName, domain: v.domain, country: v.country, industry: v.industry });
        }
        type RunRow = {
          id: string;
          vendorId: string;
          tier: string;
          status: string;
          createdAt: string;
          compositeScore: number | null;
          riskBand: string | null;
          deliveredAt: string | null;
          reportJson?: { source?: string } | null;
        };
        const runs = (runsBody as { data: RunRow[] }).data;
        const list = document.getElementById('run-list');
        const empty = document.getElementById('run-empty');

        function escapeHtml(s: string): string {
          return s
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        }

        function formatDeliveredAt(iso: string): string {
          try {
            const d = new Date(iso);
            const now = new Date();
            const diffMs = now.getTime() - d.getTime();
            const days = Math.floor(diffMs / 86400000);
            if (days === 0) return 'delivered today';
            if (days === 1) return 'delivered yesterday';
            if (days < 7) return `delivered ${days} days ago`;
            return `delivered ${d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}`;
          } catch { return ''; }
        }

        if (list) {
          if (runs.length === 0) {
            list.innerHTML = '<p class="muted">No assessments yet. Choose Start assessment to add a company and complete its questionnaire.</p>';
            if (empty) empty.hidden = false;
          } else {
            list.innerHTML = runs.map((r) => {
              const v = vendors.get(r.vendorId);
              const name = escapeHtml(v ? v.legalName : 'Unknown vendor');
              const meta = escapeHtml([v?.domain, v?.country].filter(Boolean).join(' · '));
              const questionnaire = r.reportJson?.source === 'questionnaire';
              const tierLabel = questionnaire ? 'Self-assessment' : escapeHtml(r.tier.replace('_', ' '));
              const statusLabel = questionnaire ? 'Saved answers' : escapeHtml(r.status);
              const scoreBlock = (r.compositeScore !== null && r.riskBand)
                ? `<span class="run-score">${r.compositeScore}<span class="run-score-out-of">/100</span></span>
                   <span class="pill pill-band-${escapeHtml(r.riskBand)}">${escapeHtml(r.riskBand.toLowerCase())} risk</span>`
                : '';
              const deliveredLine = r.deliveredAt
                ? `<p class="run-delivered">${escapeHtml(formatDeliveredAt(r.deliveredAt))}</p>`
                : '';
              const direction = (v?.industry ? v.industry.split(' · ')[0] : undefined) ?? 'Other';
              return `
                <div class="run-row" data-direction="${escapeHtml(direction)}" data-band="${escapeHtml(r.riskBand || 'none')}">
                  <div>
                    <p class="run-name"><a href="/vendor?id=${escapeHtml(r.vendorId)}&runId=${escapeHtml(r.id)}" class="run-link">${name}</a></p>
                    <p class="run-domain">${meta || '—'}</p>
                    ${deliveredLine}
                  </div>
                  <div class="run-meta">
                    ${scoreBlock}
                    <span class="pill pill-tier-${escapeHtml(r.tier)}">${tierLabel}</span>
                    <span class="pill pill-status-${escapeHtml(r.status)}">${statusLabel}</span>
                  </div>
                </div>
              `;
            }).join('');
            if (empty) empty.hidden = true;
          }
          const assessed = new Set(runs.map((r) => r.vendorId));
          const unassessed = Array.from(vendors.entries()).filter(([id]) => !assessed.has(id));
          if (unassessed.length > 0) {
            if (runs.length === 0) list.innerHTML = '';
            list.innerHTML += unassessed.map(([id, v]) => `
                <div class="run-row" data-direction="${escapeHtml((v.industry ? v.industry.split(' · ')[0] : undefined) ?? 'Other')}" data-band="none">
                  <div>
                    <p class="run-name"><a href="/vendor?id=${escapeHtml(id)}" class="run-link">${escapeHtml(v.legalName)}</a></p>
                    <p class="run-domain">${escapeHtml([v.domain, v.country].filter(Boolean).join(' · ')) || '—'}</p>
                  </div>
                  <div class="run-meta">
                    <span class="pill pill-status-draft">not assessed</span>
                  </div>
                </div>
              `).join('');
            if (empty) empty.hidden = true;
          }
        }

        // ── Filter chips (by direction + risk band) — client-side show/hide
        // over the already-rendered rows (system-design T3).
        const filtersEl = document.getElementById('run-filters');
        if (filtersEl && runs.length > 0) {
          const dirs = Array.from(new Set(runs.map((r) => {
            const v = vendors.get(r.vendorId);
            return (v?.industry ? v.industry.split(' · ')[0] : undefined) ?? 'Other';
          }))).sort();
          const bands = ['HIGH', 'MEDIUM', 'LOW', 'MINIMAL'].filter((b) =>
            runs.some((r) => r.riskBand === b));
          const chip = (group: string, val: string, label: string) =>
            `<button type="button" class="chip" data-group="${escapeHtml(group)}" data-val="${escapeHtml(val)}">${escapeHtml(label)}</button>`;
          filtersEl.innerHTML =
            chip('all', 'all', 'All') +
            bands.map((b) => chip('band', b, b.charAt(0) + b.slice(1).toLowerCase() + ' risk')).join('') +
            dirs.map((dd) => chip('dir', dd, dd)).join('');
          filtersEl.hidden = false;
          let activeBand = 'all', activeDir = 'all';
          const apply = () => {
            document.querySelectorAll('#run-list .run-row').forEach((row) => {
              const el = row as HTMLElement;
              const okBand = activeBand === 'all' || el.dataset.band === activeBand;
              const okDir = activeDir === 'all' || el.dataset.direction === activeDir;
              el.style.display = okBand && okDir ? '' : 'none';
            });
            filtersEl.querySelectorAll('.chip').forEach((c) => {
              const el = c as HTMLElement;
              const on = (el.dataset.group === 'all' && activeBand === 'all' && activeDir === 'all')
                || (el.dataset.group === 'band' && el.dataset.val === activeBand)
                || (el.dataset.group === 'dir' && el.dataset.val === activeDir);
              el.classList.toggle('chip-on', on);
            });
          };
          filtersEl.addEventListener('click', (e) => {
            const t = (e.target as HTMLElement).closest('.chip') as HTMLElement | null;
            if (!t) return;
            const g = t.dataset.group, val = t.dataset.val || 'all';
            if (g === 'all') { activeBand = 'all'; activeDir = 'all'; }
            else if (g === 'band') { activeBand = activeBand === val ? 'all' : val; }
            else if (g === 'dir') { activeDir = activeDir === val ? 'all' : val; }
            apply();
          });
          apply();
        }

        // ── Layer 4: Continuous-monitoring alerts feed ───────────────
        const monEl = document.getElementById('mon-feed');
        if (monEl) {
          const sig = (monBody as { data: Array<{ vendorId: string; vendorName: string; signalCode: string; severity: string; payload: any; detectedAt: string }> }).data;
          const sevRank: Record<string, number> = { critical: 0, high: 1, medium: 2, low: 3 };
          sig.sort((a, b) => (sevRank[a.severity] ?? 9) - (sevRank[b.severity] ?? 9));
          if (sig.length === 0) {
            monEl.innerHTML = '<p class="muted tiny">No active signals.</p>';
          } else {
            monEl.innerHTML = sig.slice(0, 12).map((s) => {
              const summary = s.payload && typeof s.payload === 'object'
                ? Object.entries(s.payload).slice(0, 2).map(([k, v]) => `${k}: ${v}`).join(' · ')
                : '';
              return `
                <a class="mon-row" href="/vendor?id=${escapeHtml(s.vendorId)}">
                  <span class="sev sev-${escapeHtml((s.severity || 'low').toLowerCase())}">${escapeHtml(s.severity)}</span>
                  <span class="mon-body">
                    <span class="mon-vendor">${escapeHtml(s.vendorName)}</span>
                    <span class="mon-sig">${escapeHtml(s.signalCode)} — ${escapeHtml(summary)}</span>
                  </span>
                </a>`;
            }).join('');
          }
        }

        // ── "Start assessment" inline form ───────────────────────────────
        // Vendors are independent of any tender corpus — onboard any
        // company (stable private firms included). POST /v1/vendors then
        // reload so the new vendor appears in the list.
        const avToggle = document.getElementById('add-vendor-toggle');
        const avForm = document.getElementById('add-vendor-form') as HTMLFormElement | null;
        const avCancel = document.getElementById('avf-cancel');
        const avMsg = document.getElementById('avf-msg');
        const setMsg = (t: string, err = false) => {
          if (avMsg) { avMsg.textContent = t; avMsg.classList.toggle('avf-msg-error', err); }
        };
        avToggle?.addEventListener('click', () => {
          if (avForm) { avForm.hidden = !avForm.hidden; if (!avForm.hidden) (document.getElementById('avf-name') as HTMLInputElement | null)?.focus(); }
        });
        avCancel?.addEventListener('click', () => { if (avForm) avForm.hidden = true; setMsg(''); });
        avForm?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const name = (document.getElementById('avf-name') as HTMLInputElement).value.trim();
          const domain = (document.getElementById('avf-domain') as HTMLInputElement).value.trim().toLowerCase();
          const industry = (document.getElementById('avf-industry') as HTMLInputElement).value.trim();
          const country = (document.getElementById('avf-country') as HTMLInputElement).value.trim().toUpperCase();
          if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(domain)) { setMsg('Enter a valid domain (e.g. company.az).', true); return; }
          setMsg('Adding…');
          try {
            const body: Record<string, string> = { legalName: name, domain };
            if (industry) body.industry = industry;
            if (country.length === 2) body.country = country;
            const r = await fetch(`${apiBase}/v1/vendors`, {
              method: 'POST',
              headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
              body: JSON.stringify(body),
            });
            if (r.status === 409) { setMsg('This vendor (domain) is already in your database.', true); return; }
            if (!r.ok) { setMsg(`Could not add vendor (HTTP ${r.status}).`, true); return; }
            const created = await r.json();
            setMsg('Opening questionnaire…');
            window.location.href = `/assess?vendor=${encodeURIComponent(created.id)}`;
          } catch {
            setMsg('Network error — please retry.', true);
          }
        });
      } catch {
        // Surface the failure so the user knows the page is incomplete.
        showBanner("Couldn't load your assessments.", {
          error: true,
          retry: () => window.location.reload(),
        });
      }
    } catch {
      logoutAndRedirect('/login', "Couldn't verify your session. Redirecting to sign in…");
    }
  })();
</script>
